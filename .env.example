# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional - model routing
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_INTENT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARY_FALLBACK_MODELS=openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct
GROQ_PORTFOLIO_USE_LLM_SUMMARY=false
GROQ_PORTFOLIO_SUMMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_PORTFOLIO_SUMMARY_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b

# Optional - RAG with Qdrant Cloud + Gemini Embedding
RAG_ENABLED=false
RAG_TOP_K=4
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=stock_analyst_knowledge
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional - local agent logs
AGENT_LOG_DIR=logs

# Optional - LangFuse observability (https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
